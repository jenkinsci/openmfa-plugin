<?jelly escape-by-default='true'?>
<j:jelly
  xmlns:j="jelly:core"
  xmlns:st="jelly:stapler"
  xmlns:f="/lib/form"
  xmlns:l="/lib/layout"
>
  <l:layout title="${%title}" permission="${app.READ}">
    <j:set var="instance" value="${it}" />
    <j:set var="descriptor" value="${it.descriptor}" />
    <st:adjunct
      includes="io.jenkins.plugins.openmfa.MFASetupAction.mfa-setup"
    />
    <l:side-panel>
      <st:include
        page="sidepanel.jelly"
        it="${it.targetUser}"
        optional="true"
      />
    </l:side-panel>
    <l:main-panel>
      <j:if test="${request.getParameter('success') == 'enabled'}">
        <span
          id="mfa-notification-data"
          data-type="success"
          data-msg="${%success.toast.message}"
          style="display: none"
        ></span>
      </j:if>
      <j:if test="${request.getParameter('success') == 'disabled'}">
        <span
          id="mfa-notification-data"
          data-type="success"
          data-msg="${%success.toast.disabled.message}"
          style="display: none"
        ></span>
      </j:if>
      <j:if test="${request.getParameter('error') == 'invalid_code'}">
        <span
          id="mfa-notification-data"
          data-type="error"
          data-msg="${%error.toast.invalid_code.message}"
          style="display: none"
        ></span>
      </j:if>
      <j:if test="${request.getParameter('error') == 'require_mfa'}">
        <span
          id="mfa-notification-data"
          data-type="error"
          data-msg="${%error.toast.require_mfa.message}"
          style="display: none"
        ></span>
      </j:if>
      <j:if test="${request.getParameter('success') == 'key_removed'}">
        <span
          id="mfa-notification-data"
          data-type="success"
          data-msg="${%success.toast.key_removed.message}"
          style="display: none"
        ></span>
      </j:if>
      <j:if test="${request.getParameter('error') == 'key_not_found'}">
        <span
          id="mfa-notification-data"
          data-type="error"
          data-msg="${%error.toast.key_not_found.message}"
          style="display: none"
        ></span>
      </j:if>

      <span
        id="mfa-disable-dialog-messages"
        data-title="${%disable.confirm.title}"
        data-message="${%disable.confirm.message}"
        data-cancel-text="${%disable.confirm.cancel}"
        data-ok-text="${%disable.button}"
        data-copy-feedback="${%copy.feedback}"
      >
      </span>

      <div class="mfa-container">
        <j:set var="mfaProperty" value="${it.getMFAProperty()}" />

        <j:choose>
          <j:when test="${mfaProperty != null and mfaProperty.enabled}">
            <div class="jenkins-banner jenkins-banner--success">
              <strong>${%enabled.title}</strong>
              <p class="jenkins-!-margin-top-2 jenkins-!-margin-bottom-0">
                ${%enabled.message}
              </p>
            </div>

            <div class="mfa-actions jenkins-!-margin-bottom-6">
              <form method="post" action="disable" class="mfa-disable-form">
                <button
                  type="button"
                  class="jenkins-button jenkins-!-destructive-color"
                >
                  ${%disable.button}
                </button>
              </form>
            </div>
          </j:when>
          <j:otherwise>
            <div
              class="jenkins-banner jenkins-banner--info jenkins-!-margin-bottom-6"
            >
              <strong>${%setup.title}</strong>
              <p class="jenkins-!-margin-top-2 jenkins-!-margin-bottom-0">
                ${%setup.message}
              </p>
            </div>

            <j:set var="secret" value="${it.generateSecret()}" />
            <j:set var="user" value="${it.getTargetUser()}" />
            <j:set var="qrCode" value="${it.generateQRCode(user.id, secret)}" />

            <div
              class="jenkins-card jenkins-!-margin-bottom-6 jenkins-!-margin-top-6 jenkins-!-padding-6"
            >
              <div>
                <div
                  style="
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    margin-bottom: 16px;
                  "
                >
                  <span
                    class="jenkins-button jenkins-button--primary"
                    style="pointer-events: none; min-width: 32px"
                  >
                    1
                  </span>
                  <h2 style="margin: 0">${%step1.title}</h2>
                </div>
                <p class="jenkins-!-margin-bottom-4">${%step1.message}</p>
                <div class="mfa-qr-wrapper">
                  <img src="${qrCode}" alt="${%step1.qrcode.alt}" />
                </div>
              </div>
            </div>

            <div
              class="jenkins-card jenkins-!-margin-bottom-6 jenkins-!-padding-6"
            >
              <div>
                <div
                  style="
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    margin-bottom: 16px;
                  "
                >
                  <span
                    class="jenkins-button jenkins-button--primary"
                    style="pointer-events: none; min-width: 32px"
                  >
                    2
                  </span>
                  <h2 style="margin: 0">${%step2.title}</h2>
                </div>
                <p class="jenkins-!-margin-bottom-4">${%step2.message}</p>

                <form method="post" action="enable">
                  <input
                    type="hidden"
                    name="${it.formParamSecret}"
                    value="${secret}"
                  />
                  <div class="mfa-form-group">
                    <ul>
                      <li>
                        <label>${%verification.code}</label>
                      </li>
                      <li>
                        <input
                          type="text"
                          name="${it.formParamCode}"
                          class="mfa-code-input"
                          maxlength="${it.totpCodeDigits}"
                          required="true"
                          style="margin-bottom: 0"
                          pattern="[0-9]{${it.totpCodeDigits}}"
                          placeholder="${it.codePlaceholder}"
                          autocomplete="off"
                        />
                      </li>
                      <li class="jenkins-!-margin-top-4">
                        <button
                          type="submit"
                          class="jenkins-button jenkins-button--primary"
                        >
                          ${%enable.button}
                        </button>
                      </li>
                    </ul>
                  </div>
                </form>
              </div>
            </div>
          </j:otherwise>
        </j:choose>

        <!--
          Security keys ride on top of an active TOTP enrollment: TOTP is
          the anchor, a key is never the first factor registered.
        -->
        <j:if
          test="${mfaProperty != null and mfaProperty.enabled and it.isWebAuthnAvailable()}"
        >
          <div
            id="mfa-webauthn-card"
            class="jenkins-card jenkins-!-margin-bottom-6 jenkins-!-padding-6"
            data-remove-title="${%webauthn.remove.confirm.title}"
            data-remove-message="${%webauthn.remove.confirm.message}"
            data-remove-ok="${%webauthn.remove.button}"
            data-remove-cancel="${%disable.confirm.cancel}"
          >
            <h2 class="jenkins-!-margin-bottom-2">${%webauthn.title}</h2>
            <p class="jenkins-!-margin-bottom-4">${%webauthn.message}</p>

            <j:choose>
              <j:when test="${!it.isSessionMFAVerified()}">
                <!--
                  The setup page is on the MFA filter allow-list, so being
                  here proves only that the password was right. Key
                  management needs a session that actually passed MFA.
                -->
                <div
                  id="mfa-webauthn-verify-first"
                  class="jenkins-alert jenkins-alert-warning jenkins-!-margin-bottom-0"
                >
                  <j:out
                    value="${%webauthn.verify.first(it.getLoginPath())}"
                    escapeText="false"
                  />
                </div>
              </j:when>
              <j:otherwise>
                <j:set
                  var="credentials"
                  value="${it.getWebAuthnCredentials()}"
                />

                <j:choose>
                  <j:when test="${credentials.isEmpty()}">
                    <p
                      id="mfa-webauthn-empty"
                      class="jenkins-!-margin-bottom-4"
                      style="color: var(--text-color-secondary)"
                    >
                      ${%webauthn.none}
                    </p>
                  </j:when>
                  <j:otherwise>
                    <table
                      id="mfa-webauthn-list"
                      class="jenkins-table jenkins-!-margin-bottom-4"
                    >
                      <thead>
                        <tr>
                          <th>${%webauthn.col.name}</th>
                          <th>${%webauthn.col.created}</th>
                          <th>${%webauthn.col.lastused}</th>
                          <th></th>
                        </tr>
                      </thead>
                      <tbody>
                        <j:forEach var="credential" items="${credentials}">
                          <tr>
                            <td>${credential.name}</td>
                            <td>${credential.createdAt}</td>
                            <td>
                              <j:choose>
                                <j:when test="${credential.lastUsedAt != null}">
                                  ${credential.lastUsedAt}
                                </j:when>
                                <j:otherwise>${%webauthn.never}</j:otherwise>
                              </j:choose>
                            </td>
                            <td>
                              <form
                                method="post"
                                action="${it.getWebAuthnRemoveUrl()}"
                                class="mfa-webauthn-remove-form"
                              >
                                <input
                                  type="hidden"
                                  name="${it.formParamCredentialId}"
                                  value="${credential.credentialId}"
                                />
                                <button
                                  type="button"
                                  class="jenkins-button jenkins-!-destructive-color"
                                >
                                  ${%webauthn.remove.button}
                                </button>
                              </form>
                            </td>
                          </tr>
                        </j:forEach>
                      </tbody>
                    </table>
                  </j:otherwise>
                </j:choose>

                <j:choose>
                  <j:when test="${!it.isSelfService()}">
                    <!--
                      Admins can revoke a lost key but cannot enrol one:
                      registration needs the owner's own authenticator.
                    -->
                    <p
                      id="mfa-webauthn-admin-notice"
                      class="jenkins-!-margin-bottom-0"
                      style="color: var(--text-color-secondary)"
                    >
                      ${%webauthn.admin.notice}
                    </p>
                  </j:when>
                  <j:when test="${it.isWebAuthnLimitReached()}">
                    <p
                      id="mfa-webauthn-limit"
                      class="jenkins-!-margin-bottom-0"
                      style="color: var(--text-color-secondary)"
                    >
                      ${%webauthn.limit.reached(it.getMaxWebAuthnCredentials())}
                    </p>
                  </j:when>
                  <j:otherwise>
                    <div
                      id="mfa-webauthn-add"
                      data-start-url="${it.getWebAuthnRegisterStartUrl()}"
                      data-finish-url="${it.getWebAuthnRegisterFinishUrl()}"
                      data-error-unsupported="${%webauthn.error.unsupported}"
                      data-error-generic="${%webauthn.error.generic}"
                      data-error-name_required="${%webauthn.error.name}"
                      data-error-name_too_long="${%webauthn.error.name.long(it.getWebAuthnNameMaxLength())}"
                      data-error-credential_limit="${%webauthn.limit.reached(it.getMaxWebAuthnCredentials())}"
                    >
                      <div class="mfa-form-group">
                        <ul>
                          <li>
                            <label for="mfa-webauthn-name">
                              ${%webauthn.name.label}
                            </label>
                          </li>
                          <li>
                            <input
                              type="text"
                              id="mfa-webauthn-name"
                              maxlength="${it.getWebAuthnNameMaxLength()}"
                              placeholder="${%webauthn.name.placeholder}"
                              autocomplete="off"
                              style="margin-bottom: 0"
                            />
                          </li>
                          <li class="jenkins-!-margin-top-4">
                            <button
                              type="button"
                              id="mfa-webauthn-add-button"
                              class="jenkins-button jenkins-button--primary"
                            >
                              ${%webauthn.add.button}
                            </button>
                          </li>
                        </ul>
                      </div>
                      <p
                        id="mfa-webauthn-error"
                        class="jenkins-!-margin-top-2 jenkins-!-margin-bottom-0"
                        style="display: none; color: var(--error-color)"
                      ></p>
                    </div>
                  </j:otherwise>
                </j:choose>
              </j:otherwise>
            </j:choose>
          </div>

          <st:adjunct includes="io.jenkins.plugins.openmfa.webauthn-common" />
          <st:adjunct
            includes="io.jenkins.plugins.openmfa.MFASetupAction.mfa-webauthn-setup"
          />
        </j:if>

        <div class="jenkins-alert jenkins-alert-warning">
          <h3
            style="
              margin-bottom: 0.75rem;
              display: flex;
              gap: 0.25rem;
              align-items: center;
            "
          >
            <l:icon src="symbol-warning" class="icon-md" />
            ${%notes.title}
          </h3>
          <ul class="jenkins-!-margin-0">
            <li>${%notes.required}</li>
            <li>${%notes.lost}</li>
            <li>${%notes.expiry}</li>
          </ul>
        </div>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
